---
import type { Artwork } from '../types/artwork';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;

const slides = artworks.map((artwork, i) => ({
  id: artwork.id,
  title: artwork.title,
  subtitle: [artwork.medium, artwork.year].filter(Boolean).join(', '),
  href: `/work/${artwork.slug}`,
  alt: artwork.alt,
  webp: artwork.images.hero.webp,
  jpg: artwork.images.hero.jpg,
  kb: (i % 5) + 1,
}));

const fallbackSlides = [
  { id: 'tex-1', title: 'Studio Texture I', subtitle: '', href: '', alt: 'Canvas texture in cyan and charcoal tones', webp: '', jpg: '/textures/texture-1.svg', kb: 1 },
  { id: 'tex-2', title: 'Studio Texture II', subtitle: '', href: '', alt: 'Abstract brush texture in cyan and orange', webp: '', jpg: '/textures/texture-2.svg', kb: 2 },
  { id: 'tex-3', title: 'Studio Texture III', subtitle: '', href: '', alt: 'Layered paper texture in warm contrast tones', webp: '', jpg: '/textures/texture-3.svg', kb: 3 },
];

const finalSlides = slides.length > 0 ? slides : fallbackSlides;
---

<div class="hero-cinematic" data-hero-cinematic>
  <div class="hero-cinematic__stage">
    {finalSlides.map((slide, i) => (
      <div
        class:list={['hero-cinematic__slide', i === 0 && 'is-active']}
        data-slide-index={i}
        data-kb={slide.kb}
        data-title={slide.title}
        data-subtitle={slide.subtitle}
        data-href={slide.href}
      >
        <picture>
          {slide.webp ? <source srcset={slide.webp} type="image/webp" /> : null}
          <img
            src={slide.jpg}
            alt={slide.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            draggable="false"
          />
        </picture>
      </div>
    ))}

    <div class="hero-cinematic__vignette"></div>

    <div class="hero-cinematic__overlay">
      <div class="hero-cinematic__meta" data-hero-meta>
        <p class="hero-cinematic__title" data-hero-title>{finalSlides[0]?.title ?? ''}</p>
        <p class="hero-cinematic__subtitle" data-hero-subtitle>{finalSlides[0]?.subtitle ?? ''}</p>
        {finalSlides[0]?.href ? (
          <a class="hero-cinematic__link" href={finalSlides[0].href} data-hero-link>
            View this work <span aria-hidden="true">&rarr;</span>
          </a>
        ) : null}
      </div>

      {finalSlides.length > 1 && (
        <div class="hero-cinematic__dots" role="tablist" aria-label="Artwork slides">
          {finalSlides.map((slide, i) => (
            <button
              type="button"
              role="tab"
              class:list={['hero-cinematic__dot', i === 0 && 'is-active']}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`View ${slide.title}`}
              data-dot-index={i}
            >
              <span class="hero-cinematic__dot-fill"></span>
            </button>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion } from '../scripts/motion';

  const INTERVAL = 6500;
  const FADE = 1400;

  function initHero() {
    const root = document.querySelector<HTMLElement>('[data-hero-cinematic]');
    if (!root) {
      return;
    }

    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide-index]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot-index]'));
    const titleEl = root.querySelector('[data-hero-title]');
    const subtitleEl = root.querySelector('[data-hero-subtitle]');
    const linkEl = root.querySelector<HTMLAnchorElement>('[data-hero-link]');
    const metaEl = root.querySelector<HTMLElement>('[data-hero-meta]');

    if (slides.length <= 1) {
      return;
    }

    let active = 0;
    let paused = false;
    let timer: number | undefined;

    const goTo = (index: number) => {
      if (index === active) {
        return;
      }
      const previous = active;
      active = index;

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === active);
        slide.classList.toggle('is-leaving', i === previous);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-selected', String(i === active));
      });

      metaEl?.classList.add('is-transitioning');
      window.setTimeout(() => {
        const slide = slides[active];
        if (titleEl) titleEl.textContent = slide.dataset.title ?? '';
        if (subtitleEl) subtitleEl.textContent = slide.dataset.subtitle ?? '';
        if (linkEl && slide.dataset.href) linkEl.href = slide.dataset.href;
        metaEl?.classList.remove('is-transitioning');
      }, 400);

      window.setTimeout(() => {
        slides[previous]?.classList.remove('is-leaving');
      }, FADE + 100);
    };

    const step = (direction: 1 | -1) => goTo((active + direction + slides.length) % slides.length);

    const restart = () => {
      window.clearInterval(timer);
      if (!prefersReducedMotion()) {
        timer = window.setInterval(() => {
          if (!paused && !document.hidden) {
            step(1);
          }
        }, INTERVAL);
      }
    };

    root.addEventListener('mouseenter', () => {
      paused = true;
    });
    root.addEventListener('mouseleave', () => {
      paused = false;
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(i);
        restart();
      });
    });

    // Swipe between slides on touch screens.
    let touchStart: { x: number; y: number } | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.touches[0];
        touchStart = { x: touch.clientX, y: touch.clientY };
      },
      { passive: true }
    );
    root.addEventListener(
      'touchend',
      (event) => {
        if (!touchStart) {
          return;
        }
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStart.x;
        const deltaY = touch.clientY - touchStart.y;
        touchStart = null;
        if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
          step(deltaX < 0 ? 1 : -1);
          restart();
        }
      },
      { passive: true }
    );

    restart();
    document.addEventListener('astro:before-swap', () => window.clearInterval(timer), { once: true });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
