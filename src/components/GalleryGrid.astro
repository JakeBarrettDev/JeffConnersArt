---
import type { Artwork } from '../types/artwork';

interface Props {
  artworks: Artwork[];
  title?: string;
  showFilters?: boolean;
  description?: string;
}

const { artworks, title = 'Selected Works', showFilters = true, description } = Astro.props;
const categories = Array.from(new Set(artworks.flatMap((artwork) => artwork.categories))).sort();
const layoutPattern = ['art-card art-card--feature', 'art-card', 'art-card art-card--tall', 'art-card art-card--wide', 'art-card', 'art-card art-card--tall'];
---

<section class="gallery-shell" data-gallery-root>
  <p class="section-label">Gallery</p>
  <h2>{title}</h2>
  {description ? <p>{description}</p> : null}

  {
    showFilters && categories.length > 0 ? (
      <div class="gallery-toolbar">
        <div class="category-filter" role="toolbar" aria-label="Filter artworks by category">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          {categories.map((category) => (
            <button type="button" data-filter={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>
      </div>
    ) : null
  }

  <div class="gallery-grid" data-gallery-grid>
    {
      artworks.length === 0 ? (
        <div class="empty-state">No artwork has been published yet.</div>
      ) : (
        artworks.map((artwork, index) => (
          <article
            class={layoutPattern[index % layoutPattern.length]}
            data-card
            data-reveal
            data-categories={artwork.categories.join(',')}
            style={artwork.dominantColor ? `--tint:${artwork.dominantColor}` : undefined}
          >
            <a href={`/work/${artwork.slug}`} class="art-card__link" data-art-link data-slug={artwork.slug}>
              <picture>
                <source srcset={artwork.images.medium.webp} type="image/webp" />
                <img
                  src={artwork.images.medium.jpg}
                  alt={artwork.alt}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  width={artwork.width ?? 1200}
                  height={artwork.height ?? 900}
                  data-art-image
                />
              </picture>
              <div class="art-meta">
                <h3>{artwork.title}</h3>
                <p>{[artwork.medium, artwork.year].filter(Boolean).join(' · ')}</p>
              </div>
            </a>
          </article>
        ))
      )
    }
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../scripts/motion';

  function initGallery() {
    const galleryRoot = document.querySelector<HTMLElement>('[data-gallery-root]');
    if (!galleryRoot) {
      return;
    }

    const filterButtons = Array.from(galleryRoot.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(galleryRoot.querySelectorAll<HTMLElement>('[data-card]'));
    if (filterButtons.length === 0) {
      return;
    }

    const applyFilter = (target: string) => {
      filterButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === target));
      });
      cards.forEach((card) => {
        const categoryList = (card.dataset.categories ?? '').split(',').filter(Boolean);
        const shouldShow = target === 'all' || categoryList.includes(target);
        card.toggleAttribute('hidden', !shouldShow);
        if (shouldShow) {
          card.classList.add('is-visible');
        }
      });
    };

    // Cards glide to their new spots instead of jumping.
    const animateFilter = (target: string) => {
      if (prefersReducedMotion() || !document.startViewTransition) {
        applyFilter(target);
        return;
      }

      cards.forEach((card, index) => {
        card.style.viewTransitionName = `card-${index}`;
        card.style.setProperty('view-transition-class', 'card');
        const image = card.querySelector<HTMLElement>('[data-art-image]');
        if (image) {
          image.style.viewTransitionName = '';
        }
      });

      const transition = document.startViewTransition(() => applyFilter(target));
      transition.finished.finally(() => {
        cards.forEach((card) => {
          card.style.viewTransitionName = '';
        });
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.filter ?? 'all';
        animateFilter(target);

        // Keep the filter in the URL so "back" from an artwork returns to the same view.
        const url = new URL(window.location.href);
        if (target === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', target);
        }
        history.replaceState(history.state, '', url);
      });
    });

    const initial = new URL(window.location.href).searchParams.get('category');
    if (initial && filterButtons.some((button) => button.dataset.filter === initial)) {
      applyFilter(initial);
    }
  }

  document.addEventListener('astro:page-load', initGallery);
</script>
