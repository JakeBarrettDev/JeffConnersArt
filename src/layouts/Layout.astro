---
import { ClientRouter } from 'astro:transitions';
import { facebookUrl } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  snap?: boolean;
}

const {
  title = 'Jeff Conners | Artwork',
  description = 'A minimalist, art-first portfolio featuring original work by Jeff Conners.',
  snap = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Outfit:wght@300;350;400;450;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class:list={[snap && 'snap-enabled']}>
    <div class="page-shell">
      <header class="site-header" data-site-header transition:name="site-header" transition:animate="none">
        <a href="/" class="brand">Jeff Conners</a>
        <nav aria-label="Primary">
          <a href="/gallery" aria-current={Astro.url.pathname.startsWith('/gallery') || Astro.url.pathname.startsWith('/work') ? 'page' : undefined}>Gallery</a>
          <a href="/about" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
          <a href="/contact" aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <nav class="footer-nav" aria-label="Footer">
            <a href="/gallery">Gallery</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
          </nav>
          <div class="footer-brand">
            <a href="https://MaroonRaccoon.dev" class="footer-logo" target="_blank" rel="noopener" aria-label="Maroon Raccoon LLC">
              <img src="/maroon-raccoon.svg" alt="Maroon Raccoon" width="28" height="28" />
            </a>
            <p>Maroon Raccoon LLC &times; Jeff Conners</p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
